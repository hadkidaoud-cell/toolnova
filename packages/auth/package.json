{
  "name": "@toolnova/auth",
  "version": "0.1.0",
  "private": true,
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.mjs",
      "require": "./dist/index.js"
    },
    "./auth.config": {
      "types": "./dist/auth.config.d.ts",
      "import": "./dist/auth.config.mjs",
      "require": "./dist/auth.config.js"
    }
  },
  "scripts": {
    "build": "tsup",
    "dev": "tsup --watch",
    "typecheck": "tsc --noEmit",
    "clean": "rm -rf dist .turbo node_modules"
  },
  "dependencies": {
    "@auth/prisma-adapter": "^2.11.3",
    "@prisma/client": "^7.9.1",
    "@toolnova/core": "workspace:*",
    "@toolnova/types": "workspace:*",
    "bcryptjs": "^3.0.3",
    "next-auth": "5.0.0-beta.32"
  },
  "devDependencies": {
    "tsup": "^8.3.5",
    "typescript": "^5.7.3"
  }
}
