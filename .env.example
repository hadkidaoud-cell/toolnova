# ===== ToolNova deployment environment =====
# Copy this file to `.env` on the server and fill in real values.
# `.env` is git-ignored — never commit secrets.

# Public URL of the site (no trailing slash). Baked into the web build.
PUBLIC_APP_URL=https://toolnova.com

# Generate random values with:
#   node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
WEB_AUTH_SECRET=replace-me
ADMIN_AUTH_SECRET=replace-me

# Stripe (optional until billing is wired to the UI)
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
STRIPE_PRO_PRICE_ID=
STRIPE_ENTERPRISE_PRICE_ID=

# Litestream S3/R2 backup (optional; used with `--profile backup`)
LITESTREAM_BUCKET=toolnova-db-backups
LITESTREAM_ENDPOINT=
LITESTREAM_ACCESS_KEY_ID=
LITESTREAM_SECRET_ACCESS_KEY=
